# system_gw gateway (sysnode) — a HOST build of the DISSOLUTION's multi-bus gateway,
# straight from system.toml. It speaks a DBC per bus (compute + edge), and loom2v /
# dbc2cfg consume ONE DBC, so the build MERGES the per-bus DBCs (tools/dbcmerge) into
# one that carries every frame. The route (decode VehSpeedFrame on compute, re-emit
# VehSpeed_E on edge) is generated by sysgen — nothing here is hand-wired.
#
#   sudo make -C ../../../.. vcan     # bring up vcan0..vcan7 once
#   make                              # gen (sysgen + merge + codegen) + host build
#   ./bin/app vcan0 vcan1             # run: cansend vcan0 120#... -> candump vcan1 (0x200)
V    ?= v
REPO  = ../../../..
GW    = examples/system_gw/nodes/sysnode

.PHONY: all gen build run clean
all: gen build

gen:
	@mkdir -p gen ports sig bin
	# 1) the dissolution: system.toml -> gen-<node>.toml (the gateway gets two [bus.*] + the route)
	$(MAKE) -C $(REPO) gen-system SYSTEM=examples/system_gw/system.toml
	# 2) merge the gateway's per-bus DBCs -> one DBC with every frame (ids unique across buses)
	cd $(REPO) && $(V) run tools/dbcmerge/gen.v $(GW)/gen/merged.dbc examples/system_gw/compute.dbc examples/system_gw/edge.dbc
	# 3) codec (both frames), channels, and the forwarder — from the GENERATED node toml + merged DBC
	cd $(REPO) && $(V) run tools/dbc2cfg/gen.v $(GW)/gen/merged.dbc $(GW)/gen/dbc_gen.v
	cd $(REPO) && $(V) run tools/cfg2v/gen.v examples/system_gw/gen-sysnode.toml $(GW)/gen/ecu_gen.v
	cd $(REPO) && $(V) run tools/loom2v examples/system_gw/gen-sysnode.toml $(GW)/gen/merged.dbc \
	  $(GW)/sig/signals_gen.v $(GW)/ports/ports_gen.v $(GW)/gen/loom_gen.v $(GW)/gen/trace-manifest.csv

build: gen
	@mkdir -p bin
	cd $(REPO) && $(V) -gc none -path "@vlib|@vmodules|.|$(GW)" -o $(GW)/bin/app $(GW)

run: build
	./bin/app vcan0 vcan1

clean:
	rm -rf gen ports sig bin
