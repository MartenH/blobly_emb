# Scale benchmark example. Its config (bus.dbc, ecu.toml, main.v, app/) is itself
# GENERATED by tools/scale_gen, then the normal generators run on it. Tunable:
#   make all PARTS=4 BUSES=8 FBS=50
REPO  ?= ../..
V     ?= v
NAME  := $(notdir $(CURDIR))
PARTS ?= 4
BUSES ?= 8
FBS   ?= 50

.PHONY: all config gen build run clean
all: config gen build

# Generate this example's config + FB handlers from the scale knobs.
config:
	$(V) run $(REPO)/tools/scale_gen/gen.v $(PARTS) $(BUSES) $(FBS)

gen:
	@mkdir -p gen ports sig bin
	$(V) run $(REPO)/tools/dbc2cfg/gen.v bus.dbc gen/dbc_gen.v
	$(V) run $(REPO)/tools/cfg2v/gen.v  ecu.toml gen/ecu_gen.v
	$(V) run $(REPO)/tools/loom2v/gen.v ecu.toml bus.dbc sig/signals_gen.v ports/ports_gen.v gen/loom_gen.v gen/trace-manifest.csv

build:
	@mkdir -p bin
	cd $(REPO) && $(V) -gc none -path "@vlib|@vmodules|.|examples/$(NAME)" -o examples/$(NAME)/bin/app examples/$(NAME)

run: build
	./bin/app

# Build, keeping the generated C the compiler actually used (bin/app.c via -keepc).
cfile:
	@mkdir -p bin
	cd $(REPO) && $(V) -keepc -gc none -path "@vlib|@vmodules|.|examples/$(NAME)" -o examples/$(NAME)/bin/app examples/$(NAME)
	@echo "kept C at bin/app.c: $$(wc -l < bin/app.c) lines, $$(du -h bin/app.c | cut -f1)"

clean:
	rm -rf bin gen ports sig bus.dbc ecu.toml main.v app
