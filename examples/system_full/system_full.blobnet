# Watch the system_full 2-bus ThreadX gateway on REAL hardware, live in blobly_net.
#
# THE SYSTEM (3 boards, all generated from examples/system_full/system.toml):
#   sysnode (STM32H735-DK)  — the gateway: owns both FDCAN buses, forwards 4 routes
#   domain  (NUCLEO-H755ZI) — produces VehicleSpeed + HeadlightCmd + LedLevel on the compute bus;
#                             fades its red LD3 with HostLedLevel from the tester node (0x127),
#                             which THIS TOOL simulates on the bench
#   zone_a  (NUCLEO-H723ZG) — produces SteeringAngle on the edge bus (CAN-FD, 500k/2M)
#
# blobly_net LISTENS on edge (monitor) but is a MEMBER on compute: it restbus-simulates the
# tester node there (mode normal — it TRANSMITS HostLedFrame 0x127, see `simulation:` below) and
# decodes each bus with its DBC, so you can SEE the gateway forward: the same value appears
# on the other bus under a new id.
#
#   compute bus (SocketCAN can0):
#     0x120 VehSpeedFrame     (domain)   ─┐ gateway ┌─► 0x130 VehSpeedFrame_E     on edge
#     0x123 HeadlightCmdFrame (domain)   ─┤  copies ├─► 0x131 HeadlightCmdFrame_E on edge
#     0x126 LedLevelFrame     (domain)   ─┘         └─► 0x133 LedLevelFrame_E     on edge
#     0x125 SteeringFrame_C   ◄── gateway forwards zone_a's steering here
#     0x7E0/0x7E1 sysnode telemetry, 0x7E2/0x7E3 domain telemetry (raw — not in the DBC)
#   edge bus (SocketCAN can1):
#     0x132 SteeringFrame     (zone_a)   ──── gateway ───► 0x125 on compute
#     0x130 / 0x131 / 0x133  ◄── gateway forwards domain's speed / headlight / led level here
#     0x7E4/0x7E5 zone_a telemetry (raw)
#
# The closed loop is visible: watch 0x125 (SteeringAngle on compute) climb past 90 and
# 0x123 (HeadlightCmd) flip to 1 — domain reacting to steering that arrived via the gateway.
#
# WIRING (this bench): the CANsub.4 tap — channel 2 = COMPUTE (classic 500 kbit), channel 1 =
# EDGE (CAN-FD, 500 kbit arbitration / 2 Mbit data with BRS). Nothing to bring up by hand: the
# CANsub is reached by DEVICE ID over mDNS (e5a16adf-usb.local) and configured over REST by the
# tool. Edge REQUIRES an FD-capable adapter — a classic one cannot ACK the 2 Mbit BRS frames.
#
# With a SocketCAN adapter instead (PCAN), swap both adapter/address pairs back to socketcan
# can0/can1 and bring them up first:
#     sudo ip link set can0 up type can bitrate 500000
#     sudo ip link set can1 up type can bitrate 500000 dbitrate 2000000 fd on
#
# FLASH the boards (in blobly_emb) — see boards/common/bench serials:
#     make -C examples/system_full nodes
#     make -C examples/system_full/nodes/sysnode   flash SERIAL=001C002C3133510237363734  # H735
#     make -C examples/system_full/nodes/domain    flash SERIAL=001E00243335510835383531  # H755 CM7 (bank 1)
#     make -C examples/system_full/nodes/domain_m4 flash SERIAL=001E00243335510835383531  # H755 CM4 (bank 2)
#     make -C examples/system_full/nodes/zone_a    flash SERIAL=005500333233510739363634  # H723
# (the H755 needs BOTH banks — without domain_m4 on bank 2 the CM4 is dead and no cross-core
#  bulk / CpuLoad runs; a reset after flashing both starts the dual-core node.)
#
# RUN (from the blobly_net repo — point BLOBLY_PROJECT at your blobly_emb checkout; the DBC
# paths above are relative to THIS file, so any checkout works):
#     BLOBLY_PROJECT=/path/to/blobly_emb/examples/system_full/system_full.blobnet ./scripts/run_gui.sh
project:
  name: system_full — 2-bus ThreadX gateway
  version: 2

buses:
  # --- compute bus: domain (H755) <-> gateway (H735 FDCAN1) ---
  - name: compute
    network: system_full
    adapter: cansub          # the bench tap: CSS Electronics CANsub.4, found by device id (mDNS)
    address: e5a16adf/2      # CANsub channel 2 = the compute bus (classic 500 kbit)
    protocol: can
    bitrate: 500000
    mode: normal             # this tool stands in for the "tester" node here (restbus sim)
    enabled: true
    # The tester node (nodes/tester) is not on the bench — blobly_net simulates it, as it would
    # any absent ECU: HostLedLevel (0..1000 permille, 0.5 Hz), which the H755 puts on its own
    # red LD3 as PWM — the mirror of LedLevel, which the H755 breathes to the H723 through the
    # gateway. "tester" is the DBC transmitter of HostLedFrame.
    simulation:
      - name: tester
        signals:
          - { name: HostLedLevel, type: sine, offset: 500, amplitude: 500, freq: 0.5 }
    manifest: nodes/domain/gen/trace-manifest.csv  # the domain node's CAN shell frames
                                                    # (0x7F0/0x7F2/0x7F1) — WITHOUT this the shell
                                                    # panel reports "shell not available". Type
                                                    # `bulkperf` on this bus. resolve_asset -> here.
    databases:
      - compute.dbc            # resolved against this .blobnet's own dir (blobly_net resolve_asset)

  # --- edge bus: zone_a (H723) <-> gateway (H735 FDCAN2) ---
  - name: edge
    network: system_full
    adapter: cansub          # edge is CAN-FD now: this tap is FD-capable (HW-verified to 2 Mbit)
    address: e5a16adf/1      # CANsub channel 1 = the edge bus
    protocol: canfd          # edge runs CAN-FD: 500 kbit arbitration, 2 Mbit data phase (BRS)
    bitrate: 500000
    data_bitrate: 2000000
    mode: monitor
    enabled: true
    databases:
      - edge.dbc               # resolved against this .blobnet's own dir (blobly_net resolve_asset)
