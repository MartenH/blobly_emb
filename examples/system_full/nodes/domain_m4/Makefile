# domain_m4 — the system_full domain node's Cortex-M4 satellite (flash bank 2). ThreadX + the
# DynamicsModel FB; the CM7 owner (../domain) brings up clocks/pins/bus and declares this whole
# node (partition "dynamics", image = "nodes/domain_m4"). Build after the owner's gen:
#     make -C ../domain gen && make flash
CROSS   ?= arm-none-eabi-
CC       = $(CROSS)gcc
AR       = $(CROSS)ar
OBJCOPY  = $(CROSS)objcopy
SIZE     = $(CROSS)size
V       ?= v
REPO     = ../../../..
NAME    := $(notdir $(CURDIR))
MOD      = examples/system_full/nodes/$(NAME)
OWNER    = ../domain
TX       = $(REPO)/third_party/threadx
PORT     = $(TX)/ports/cortex_m4/gnu

BOARD := h755zi
include $(REPO)/boards/$(BOARD)/board.mk

# TX_ENABLE_EXECUTION_CHANGE_NOTIFY: this core records its OWN thread/ISR trace (trace_hooks.c).
CFLAGS  = $(MCU_CM4) -Os -g -ffreestanding -ffunction-sections -fdata-sections \
          $(BOARD_DEFS_CM4) -DBOARD_ENTRY=main__main -DTX_ENABLE_EXECUTION_CHANGE_NOTIFY \
          -I. -I$(OWNER)/gen $(BOARD_INCS) -I$(PORT)/inc -I$(TX)/common/inc $(CMSIS)
LDFLAGS = $(MCU_CM4) -T $(BOARD_LD_CM4_THREADX) -nostartfiles -Wl,--gc-sections \
          --specs=nano.specs --specs=nosys.specs -Wl,-Map=$(BUILD)/app.map

BUILD = build
TX_A  = $(BUILD)/tx.a
TX_ASM = $(wildcard $(PORT)/src/*.S)
TX_C   = $(filter-out %/tx_misra.c,$(wildcard $(TX)/common/src/*.c))
TX_OBJ = $(patsubst $(PORT)/src/%.S,$(BUILD)/tx/%.o,$(TX_ASM)) \
         $(patsubst $(TX)/common/src/%.c,$(BUILD)/tx/%.o,$(TX_C))

BSP = $(BOARD_BSP_CM4_THREADX) $(BOARD_BSP_CM4_BARE) m4_glue.c \
      $(REPO)/boards/common/trace_hooks.c

all: $(BUILD)/$(NAME).bin

# gen/, ports/, sig/ are GENERATED by the OWNER node's loom2v run (its ecu.toml declares this
# whole node — partition "dynamics", image = "nodes/domain_m4"): regenerate there.
gen/loom_gen.v:
	$(MAKE) -C $(OWNER) gen

# loom's fixed Scheduler tables, right-sized to this image's real per-thread handler count.
-include gen/loom_build.mk

$(BUILD)/app.c: main.v gen/loom_gen.v $(wildcard app/*.v) $(wildcard $(REPO)/loom/*.v) | $(BUILD)
	cd $(REPO) && $(V) -freestanding -gc none -no-bounds-checking -enable-globals $(LOOM_VDEFS) \
	  -path "@vlib|@vmodules|.|$(MOD)" \
	  -o $(MOD)/$(BUILD)/app.c $(MOD)/main.v
	$(REPO)/scripts/lint_vinit.sh $@

$(BUILD)/tx/%.o: $(PORT)/src/%.S Makefile
	@mkdir -p $(BUILD)/tx
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD)/tx/%.o: $(TX)/common/src/%.c Makefile
	@mkdir -p $(BUILD)/tx
	$(CC) $(CFLAGS) -c $< -o $@
$(TX_A): $(TX_OBJ)
	$(AR) -rc $@ $^

$(BUILD)/$(NAME).elf: $(BUILD)/app.c $(BSP) $(TX_A) $(BOARD_LD_CM4_THREADX)
	$(CC) $(CFLAGS) $(LDFLAGS) $(BUILD)/app.c $(BSP) $(TX_A) -o $@
	$(SIZE) $@

$(BUILD)/$(NAME).bin: $(BUILD)/$(NAME).elf
	$(OBJCOPY) -O binary $< $@

$(BUILD):
	mkdir -p $(BUILD)

flash: $(BUILD)/$(NAME).bin
	st-flash $(if $(SERIAL),--serial $(SERIAL),) write $(BUILD)/$(NAME).bin 0x08100000
	st-flash $(if $(SERIAL),--serial $(SERIAL),) reset

clean:
	rm -rf $(BUILD)

.PHONY: all flash clean
.DELETE_ON_ERROR:
