# Compiled binaries (V output)
/blobly_emb
/blobly_demo
/blobly_demo_threadx

# V build artifacts
*.tmp.c
*.o
*.so
/v
vls.log

# Editor / OS
.DS_Store
*.swp

# example binaries
/blobly_demo
/blobly_demo_threadx
bin/

# `v run tools/<t>/gen.v` can leave the compiled binary beside its source; the CI
# freshness gate treats any untracked file as drift, so keep the spill invisible
tools/*/gen

# vendored CMSIS headers for the bare-metal STM32 examples (fetch via `make deps`)
third_party/

# bare-metal example build output
examples/**/build/
examples/**/gen/.stamp

# sysgen output (regenerable from system.toml, P1b)
examples/**/gen-*.toml

# multi-node per-node loom2v output (regenerable via `make -C examples/<system>`;
# the dissolution demonstrators build each node from its generated gen-<node>.toml)
examples/*/nodes/*/gen/
examples/*/nodes/*/ports/
examples/*/nodes/*/sig/

# the CI's own V toolchain: vlang/setup-v builds V inside the workspace, and the
# freshness gate reads any untracked file as generated-output drift
vlang/

# Agent working state — sessions, worktrees, scratch. Excluded here rather than only in
# .git/info/exclude, which is local to one clone and silently absent from every other.
.claude/

# Compiled V tool binaries: `v -o tools/<t>/<t> ...` drops the executable beside its source.
# Several of these (loom2v, cfg2v, dbc2cfg, dbcmerge — 5.8 MB) were committed once already.
tools/loom2v/loom2v
tools/cfg2v/cfg2v
tools/dbc2cfg/dbc2cfg
tools/dbcmerge/dbcmerge
tools/syscheck/syscheck
tools/sysgen/sysgen
tools/ecucheck/ecucheck

# Compiled test binaries: `v -o <dir>/<name> <name>_test.v` drops the executable beside
# its source. One (tools/bulk/bulk_test) reached a PR after the tool binaries above were
# already ignored, so cover the shape rather than each name.
tools/*/*_test

